{
  "name": "pi-extensions",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Declarative hooks for the Pi coding agent, shipped as pi packages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tadasant/pi-extensions.git"
  },
  "engines": {
    "node": ">=20.10"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:pin": "node scripts/check-pi-pin.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "pi:install": "node scripts/install-pinned-pi.mjs",
    "pack:dry-run": "node scripts/pack-dry-run.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "^22.10.2",
    "typebox": "^1.3.7",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
