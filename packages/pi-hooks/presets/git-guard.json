{
  "$schema": "../schema/hooks.schema.json",
  "hooks": [
    {
      "name": "block-force-push",
      "on": "tool_call",
      "match": {
        "tool": "bash",
        "input": {
          "command": "/git\\s+(-[^\\s]+\\s+([^\\s-][^\\s]*\\s+)?)*push\\b[^&|;\\n]*(--force(?!-with-lease)|(^|\\s)-f(\\s|$))/m"
        }
      },
      "action": {
        "type": "block",
        "reason": "pi-hooks/git-guard: plain `git push --force` discards work you cannot see. Use `--force-with-lease`, or push without force.",
        "terminate": false
      }
    },
    {
      "name": "block-push-to-default-branch",
      "on": "tool_call",
      "match": {
        "tool": "bash",
        "input": {
          "command": "/git\\s+(-[^\\s]+\\s+([^\\s-][^\\s]*\\s+)?)*push\\b[^&|;\\n]*\\s(main|master|HEAD)(\\s|$)/m"
        }
      },
      "action": {
        "type": "block",
        "reason": "pi-hooks/git-guard: pushing straight to main/master is not allowed. Open a pull request from a feature branch instead."
      }
    },
    {
      "name": "block-history-rewrite",
      "on": "tool_call",
      "match": {
        "tool": "bash",
        "input": {
          "command": "/git\\s+(-[^\\s]+\\s+([^\\s-][^\\s]*\\s+)?)*(reset\\s+--hard|clean\\s+-[a-z]*[fd]|checkout\\s+--\\s+\\.|restore\\s+--staged\\s+--worktree)/m"
        }
      },
      "action": {
        "type": "block",
        "reason": "pi-hooks/git-guard: `{{input.command}}` throws away uncommitted work irreversibly. Commit or stash first, then re-run."
      }
    }
  ]
}
