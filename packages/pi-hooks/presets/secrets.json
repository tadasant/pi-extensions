{
  "$schema": "../schema/hooks.schema.json",
  "hooks": [
    {
      "name": "block-secret-file-writes",
      "on": "tool_call",
      "match": {
        "tool": ["write", "edit"],
        "input": {
          "path": [
            "**/.env",
            "**/.env.*",
            "!**/.env.example",
            "!**/.env.sample",
            "**/*.pem",
            "**/*.p12",
            "**/*.pfx",
            "**/id_rsa",
            "**/id_ed25519",
            "**/.npmrc",
            "**/.netrc",
            "**/credentials",
            "**/*serviceaccount*.json"
          ]
        }
      },
      "action": {
        "type": "block",
        "reason": "pi-hooks/secrets: refusing to modify {{input.path}}. Secret material is edited by a human, not the agent. Ask the user to make this change, or add an exception to your hooks config."
      }
    },
    {
      "name": "block-secret-file-reads",
      "on": "tool_call",
      "match": {
        "tool": "read",
        "input": {
          "path": [
            "**/.env",
            "**/.env.*",
            "!**/.env.example",
            "!**/.env.sample",
            "**/*.pem",
            "**/id_rsa",
            "**/id_ed25519",
            "**/.netrc"
          ]
        }
      },
      "action": {
        "type": "block",
        "reason": "pi-hooks/secrets: refusing to read {{input.path}}. Reading a secret puts it in the model's context and in the session transcript."
      }
    },
    {
      "name": "block-secret-exfiltration-via-bash",
      "on": "tool_call",
      "match": {
        "tool": "bash",
        "input": {
          "command": "/(cat|less|more|head|tail|bat|xxd|base64)\\s+[^|;&\\n]*(\\.env(\\.|\\s|$)|id_rsa|id_ed25519|\\.netrc|\\.pem)/m"
        }
      },
      "action": {
        "type": "block",
        "reason": "pi-hooks/secrets: that command would print secret material into the transcript. Read the value from the environment at runtime instead."
      }
    }
  ]
}
