{
  "$schema": "../schema/hooks.schema.json",
  "hooks": [
    {
      "name": "inject-git-status",
      "on": "before_agent_start",
      "once": true,
      "action": {
        "type": "command",
        "argv": [
          "node",
          "-e",
          "const{execFileSync}=require('node:child_process');let out='';try{out=execFileSync('git',['status','--short','--branch'],{encoding:'utf8'});}catch{process.exit(0);}process.stdout.write(JSON.stringify({context:'Repository state at session start:\\n'+out.split('\\n').slice(0,20).join('\\n')}));"
        ],
        "timeoutMs": 5000,
        "blockOnFailure": false
      }
    }
  ]
}
